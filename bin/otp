#!/usr/bin/env python3
"""omarchy TOTP helper — the data layer behind the psamoluk.totp bar widget.

Generates RFC 6238 codes locally. Nothing here talks to the network.

Storage
  ~/.local/share/psamoluk.totp/accounts.json  (0600) account metadata only
  secrets in the login keyring via secret-tool (service "psamoluk.totp"),
  falling back to the same 0600 file when no keyring backend answers.

Commands
  list [--json]                 current codes
  add --label NAME [--issuer X] [--digits 6] [--period 30] [--algorithm SHA1]
                                secret from --secret / OTP_SECRET / stdin ("-")
  add-uri [otpauth://URI]       URI from OTP_URI env, argv, or stdin
  add-qr [PATH|--clipboard]     read the otpauth:// URI out of a QR screenshot
  remove NAME|--id ID
  copy NAME|--id ID             copy the current code (60 s auto-clear)
  lock status                   {"configured", "vault", "unlocked"}
  lock set                      encrypt every secret under a master password
  lock unlock                   verify + open the session (password on stdin)
  lock now                      drop the session key (lock immediately)
  lock clear                    remove the password, secrets back to the keyring
  lock reset --yes              destroy the vault and every account
  check                         backend + account count
"""

import base64
import hashlib
import hmac
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.parse
from pathlib import Path

DATA_DIR = Path(os.environ.get("TOTP_DATA_DIR") or (Path.home() / ".local/share/psamoluk.totp"))
INDEX = DATA_DIR / "accounts.json"
LOCK = DATA_DIR / "lock.json"          # legacy password gate (pre-vault installs)
VAULT = DATA_DIR / "vault.gpg"         # secrets, encrypted with the master password
SESSION_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()) / "psamoluk.totp"
SESSION = SESSION_DIR / "session"
LOCK_ITERATIONS = 300_000
SERVICE = "psamoluk.totp"
KEYRING_LABEL = "omarchy-totp"

ALGOS = {"SHA1": hashlib.sha1, "SHA256": hashlib.sha256, "SHA512": hashlib.sha512}


# ---------------------------------------------------------------- storage ----


def load_index():
    try:
        with INDEX.open() as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return {"version": 1, "backend": None, "accounts": []}
    except (OSError, ValueError) as exc:
        raise SystemExit(f"otp: cannot read {INDEX}: {exc}")
    if isinstance(data, list):  # very old shape
        data = {"version": 1, "backend": None, "accounts": data}
    data.setdefault("version", 1)
    data.setdefault("backend", None)
    data.setdefault("accounts", [])
    return data


def save_index(data):
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(DATA_DIR, 0o700)
    fd, tmp = tempfile.mkstemp(dir=str(DATA_DIR), prefix=".accounts.", suffix=".json")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(data, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, INDEX)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _secret_tool(*args, stdin=None):
    return subprocess.run(
        ["secret-tool", *args],
        input=stdin,
        capture_output=True,
        text=True,
        timeout=10,
    )


def keyring_available():
    if not shutil.which("secret-tool"):
        return False
    try:
        probe = _secret_tool("lookup", "service", SERVICE, "account", "__probe__")
    except (OSError, subprocess.SubprocessError):
        return False
    # A missing item exits non-zero too; only a hard failure (no bus/keyring)
    # produces stderr we care about.
    err = (probe.stderr or "").lower()
    return not any(word in err for word in ("cannot", "failed", "no such", "not found", "dbus"))


def secret_for(account):
    if VAULT.exists():
        return vault_read(require_session())["secrets"].get(account["id"])
    if account.get("store") == "file":
        return account.get("secret")
    try:
        proc = _secret_tool("lookup", "service", SERVICE, "account", account["id"])
    except (OSError, subprocess.SubprocessError):
        # A locked keyring can stall the lookup; the widget must still get JSON.
        return account.get("secret")
    if proc.returncode == 0:
        return proc.stdout.strip()
    return account.get("secret")


def secret_set(account, secret, data):
    """Store the secret where the account says; drop the file copy if unused."""
    if VAULT.exists():
        password = require_session()
        vault = vault_read(password)
        vault["secrets"][account["id"]] = secret
        vault_write(password, vault)
        account["store"] = "vault"
        account.pop("secret", None)
        return True
    if data.get("backend") == "keyring" and keyring_available():
        proc = _secret_tool(
            "store",
            "--label",
            f"{KEYRING_LABEL}: {account['label']}",
            "service",
            SERVICE,
            "account",
            account["id"],
            stdin=secret + "\n",
        )
        if proc.returncode == 0:
            account["store"] = "keyring"
            account.pop("secret", None)
            return True
    account["store"] = "file"
    account["secret"] = secret
    return True


def keyring_secret_del(account):
    """Drop the pre-vault copy only (keyring item or inline field)."""
    if account.get("store") == "keyring":
        _secret_tool("clear", "service", SERVICE, "account", account["id"])
    account.pop("secret", None)


def migrate_to_vault(password):
    """One-time upgrade: legacy password gate -> encrypted vault.

    Runs on the unlock that verifies the legacy password, so an existing
    install lands on encryption without being asked to set a new password.
    """
    data = load_index()
    vault = {"version": 1, "secrets": {}}
    for account in data["accounts"]:
        secret = account.get("secret")
        if not secret and account.get("store") != "file":
            proc = _secret_tool("lookup", "service", SERVICE, "account", account["id"])
            secret = proc.stdout.strip() if proc.returncode == 0 else ""
        if secret:
            vault["secrets"][account["id"]] = secret
    vault_write(password, vault)
    for account in data["accounts"]:
        keyring_secret_del(account)
        account["store"] = "vault"
    save_index(data)
    try:
        LOCK.unlink()
    except OSError:
        pass
    print("otp: secret gate upgraded to an encrypted vault", file=sys.stderr)


def secret_del(account):
    if VAULT.exists():
        password = session_password()
        if password:
            vault = vault_read(password)
            if vault["secrets"].pop(account["id"], None) is not None:
                vault_write(password, vault)
        account.pop("secret", None)
        return
    if account.get("store") == "keyring":
        _secret_tool("clear", "service", SERVICE, "account", account["id"])
    account.pop("secret", None)


# ------------------------------------------------------------------- lock ----
#
# A screen lock, not encryption: the secrets stay in the login keyring, this
# gate stops someone at an unlocked desktop from reading codes over your
# shoulder. Removing lock.json clears it (and that is the documented recovery),
# so it is deliberately not sold as protection against a shell account.


def _gpg(args, password, data_file=None):
    """Run gpg symmetric, passphrase over stdin, payload via a file.

    --no-symkey-cache keeps the agent from caching the passphrase, which would
    otherwise let a later process decrypt without knowing it.
    """
    if not shutil.which("gpg"):
        raise SystemExit("otp: gpg is not installed")
    try:
        return subprocess.run(
            [
                "gpg", "--batch", "--yes", "--quiet",
                "--pinentry-mode", "loopback",
                "--no-symkey-cache",
                "--passphrase-fd", "0",
                *args,
            ],
            input=(password + "\n").encode(),
            capture_output=True,
            timeout=60,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise SystemExit(f"otp: gpg failed ({exc})")


def session_password():
    try:
        return SESSION.read_text().rstrip("\n")
    except OSError:
        return None


def set_session(password):
    SESSION_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(SESSION_DIR, 0o700)
    fd, tmp = tempfile.mkstemp(dir=str(SESSION_DIR), prefix=".session.")
    with os.fdopen(fd, "w") as fh:
        fh.write(password + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, SESSION)


def clear_session():
    try:
        SESSION.unlink()
    except OSError:
        pass


def vault_mode():
    return VAULT.exists()


def vault_read(password):
    """Decrypt the vault. Raises SystemExit with a readable reason on failure."""
    proc = _gpg(["--decrypt", "--output", "-", str(VAULT)], password)
    if proc.returncode != 0:
        raise SystemExit("otp: wrong password")
    try:
        data = json.loads(proc.stdout.decode() or "{}")
    except ValueError:
        raise SystemExit("otp: the vault is damaged")
    data.setdefault("version", 1)
    data.setdefault("secrets", {})
    return data


def vault_write(password, data):
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(DATA_DIR, 0o700)
    fd, plain = tempfile.mkstemp(dir=str(DATA_DIR), prefix=".vault.", suffix=".json")
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
    encrypted = plain + ".gpg"
    try:
        proc = _gpg(
            [
                "--symmetric", "--cipher-algo", "AES256",
                "--s2k-digest-algo", "SHA512", "--s2k-count", "65011712",
                "--output", encrypted, plain,
            ],
            password,
        )
        if proc.returncode != 0:
            raise SystemExit("otp: could not write the vault")
        os.chmod(encrypted, 0o600)
        os.replace(encrypted, VAULT)
    finally:
        for path in (plain, encrypted):
            try:
                os.unlink(path)
            except OSError:
                pass


def require_session():
    password = session_password()
    if not password:
        raise SystemExit("otp: locked — unlock with the master password first")
    return password


def lock_state():
    try:
        with LOCK.open() as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict) or "salt" not in data or "hash" not in data:
        return None
    return data


def lock_derive(password, salt, iterations):
    return hashlib.pbkdf2_hmac("sha256", password.encode(), salt, int(iterations))


def read_password(env_key="OTP_PASSWORD"):
    value = os.environ.get(env_key, "")
    if value:
        return value
    if not sys.stdin.isatty():
        return sys.stdin.readline().rstrip("\r\n")
    return ""


# ------------------------------------------------------------------- totp ----


def normalize_secret(secret):
    cleaned = "".join(ch for ch in (secret or "").upper() if ch.isalnum())
    pad = (-len(cleaned)) % 8
    return cleaned + "=" * pad


def b32decode(secret):
    raw = normalize_secret(secret)
    try:
        return base64.b32decode(raw, casefold=True)
    except Exception as exc:  # noqa: BLE001 - surfaced to the user
        raise SystemExit(f"otp: secret is not valid base32 ({exc})")


def totp(secret, period=30, digits=6, algorithm="SHA1", at=None):
    at = time.time() if at is None else at
    period = int(period or 30)
    digits = int(digits or 6)
    algo = ALGOS[str(algorithm or "SHA1").upper()]
    counter = int(at // period)
    digest = hmac.new(b32decode(secret), counter.to_bytes(8, "big"), algo).digest()
    offset = digest[-1] & 0x0F
    value = (
        (digest[offset] & 0x7F) << 24
        | digest[offset + 1] << 16
        | digest[offset + 2] << 8
        | digest[offset + 3]
    ) % (10 ** digits)
    expires_at = (counter + 1) * period
    return {
        "code": str(value).zfill(digits),
        "remaining": max(0, int(expires_at - at)),
        "expires_at": int(expires_at),
        "period": period,
        "digits": digits,
    }


def code_for(account):
    try:
        secret = secret_for(account)
    except Exception:  # noqa: BLE001 - never traceback into the panel
        secret = None
    if not secret:
        return {"code": "", "remaining": 0, "expires_at": 0, "error": "secret unavailable"}
    try:
        return totp(
            secret,
            period=account.get("period", 30),
            digits=account.get("digits", 6),
            algorithm=account.get("algorithm", "SHA1"),
        )
    except SystemExit as exc:
        return {"code": "", "remaining": 0, "expires_at": 0, "error": str(exc)}


# --------------------------------------------------------------- accounts ----


def find_account(data, name=None, ident=None):
    for account in data["accounts"]:
        if ident and account["id"] == ident:
            return account
    if name:
        needle = name.strip().lower()
        for account in data["accounts"]:
            if account["label"].lower() == needle or account.get("issuer", "").lower() == needle:
                return account
    return None


def slug(label, taken):
    base = "".join(ch if ch.isalnum() else "-" for ch in label.lower()).strip("-") or "account"
    while base in taken:
        base += "2"
    return base


def add_account(data, label, issuer, secret, digits, period, algorithm):
    label = (label or "").strip()
    if not label:
        raise SystemExit("otp: a label is required")
    b32decode(secret)  # validate before storing anything
    if find_account(data, name=label):
        raise SystemExit(f"otp: an account labelled {label!r} already exists")
    taken = {a["id"] for a in data["accounts"]}
    account = {
        "id": slug(label, taken),
        "label": label,
        "issuer": (issuer or "").strip(),
        "digits": int(digits or 6),
        "period": int(period or 30),
        "algorithm": str(algorithm or "SHA1").upper(),
    }
    if data.get("backend") is None:
        data["backend"] = "keyring" if keyring_available() else "file"
    secret_set(account, secret.strip().replace(" ", ""), data)
    data["accounts"].append(account)
    save_index(data)
    return account


def parse_uri(uri):
    uri = uri.strip()
    if not uri.startswith("otpauth://"):
        raise SystemExit("otp: expected an otpauth:// URI")
    parsed = urllib.parse.urlparse(uri)
    params = urllib.parse.parse_qs(parsed.query)
    kind = parsed.netloc.lower()
    if kind != "totp":
        raise SystemExit(f"otp: only TOTP is supported (got {kind!r})")
    path = urllib.parse.unquote(parsed.path.lstrip("/"))
    issuer = (params.get("issuer", [""])[0] or "").strip()
    if ":" in path:
        prefix, _, account_name = path.partition(":")
        issuer = issuer or prefix.strip()
        path = account_name.strip()
    secret = (params.get("secret", [""])[0] or "").strip()
    if not secret:
        raise SystemExit("otp: the URI carries no secret")
    return {
        "label": path or issuer or "account",
        "issuer": issuer,
        "secret": secret,
        "digits": params.get("digits", ["6"])[0],
        "period": params.get("period", ["30"])[0],
        "algorithm": params.get("algorithm", ["SHA1"])[0],
    }


def qr_payload(path):
    """Decode the otpauth:// payload out of a QR image with zbar."""
    if not shutil.which("zbarimg"):
        raise SystemExit("otp: zbarimg is not installed (pacman -S zbar)")
    try:
        proc = subprocess.run(
            ["zbarimg", "--quiet", "--raw", path],
            capture_output=True,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise SystemExit(f"otp: could not read the image ({exc})")
    for line in (proc.stdout or "").splitlines():
        line = line.strip()
        if line.startswith("otpauth://"):
            return line
    raise SystemExit("otp: no otpauth:// QR code in that image")


def clipboard_image(suffix_png=b"\x89PNG\r\n\x1a\n"):
    """Write whatever image is on the Wayland clipboard to a temp file."""
    if not shutil.which("wl-paste"):
        raise SystemExit("otp: wl-paste is not installed (wl-clipboard)")
    for mime, ext in (
        ("image/png", ".png"),
        ("image/jpeg", ".jpg"),
        ("image/webp", ".webp"),
    ):
        try:
            listed = subprocess.run(
                ["wl-paste", "--list-types"], capture_output=True, text=True, timeout=5
            )
        except subprocess.SubprocessError:
            raise SystemExit("otp: the clipboard did not answer")
        if mime not in (listed.stdout or ""):
            continue
        try:
            data = subprocess.run(
                ["wl-paste", "--type", mime], capture_output=True, timeout=15
            ).stdout
        except subprocess.SubprocessError:
            raise SystemExit("otp: reading the clipboard timed out")
        if not data:
            continue
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(DATA_DIR, 0o700)
        fd, path = tempfile.mkstemp(dir=str(DATA_DIR), prefix=".qr.", suffix=ext)
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        return path
    raise SystemExit("otp: no image on the clipboard")


def read_stdin_or_env(env_key):
    value = os.environ.get(env_key, "")
    if value:
        return value
    if not sys.stdin.isatty():
        # One line, not read-to-EOF: the widget's Process writes the value and
        # never closes the pipe, so read() would block the panel forever.
        return sys.stdin.readline()
    return ""


# ------------------------------------------------------------------- cli -----


def cmd_list(argv):
    as_json = "--json" in argv
    if VAULT.exists() and not session_password():
        if as_json:
            print(json.dumps({"backend": "vault", "accounts": [], "now": int(time.time()), "locked": True}))
            return 0
        raise SystemExit("otp: locked — unlock with the master password first")
    data = load_index()
    rows = []
    for account in data["accounts"]:
        info = code_for(account)
        rows.append(
            {
                "id": account["id"],
                "label": account["label"],
                "issuer": account.get("issuer", ""),
                "digits": account.get("digits", 6),
                "period": account.get("period", 30),
                "store": account.get("store", "file"),
                **info,
            }
        )
    if as_json:
        print(
            json.dumps(
                {
                    "backend": data.get("backend") or "file",
                    "accounts": rows,
                    "now": int(time.time()),
                }
            )
        )
        return 0
    if not rows:
        print("no accounts — add one: omarchy-totp add --label GitHub")
        return 0
    for row in rows:
        code = row["code"] or "------"
        print(f"{row['label']:<28} {code:>8}  {row['remaining']:>2}s")
    return 0


def cmd_add(argv):
    opts = {"digits": 6, "period": 30, "algorithm": "SHA1", "issuer": ""}
    secret = ""
    label = ""
    rest = list(argv)
    while rest:
        flag = rest.pop(0)
        if flag in ("--label", "-l") and rest:
            label = rest.pop(0)
        elif flag in ("--issuer", "-i") and rest:
            opts["issuer"] = rest.pop(0)
        elif flag in ("--secret", "-s") and rest:
            secret = rest.pop(0)
        elif flag == "--digits" and rest:
            opts["digits"] = rest.pop(0)
        elif flag == "--period" and rest:
            opts["period"] = rest.pop(0)
        elif flag == "--algorithm" and rest:
            opts["algorithm"] = rest.pop(0)
        else:
            raise SystemExit(f"otp: unknown option {flag}")
    if not secret or secret == "-":
        secret = read_stdin_or_env("OTP_SECRET").strip()
    data = load_index()
    account = add_account(
        data, label or opts["issuer"], opts["issuer"], secret,
        opts["digits"], opts["period"], opts["algorithm"],
    )
    print(f"added {account['label']} ({account['id']}, {account['store']})")
    return 0


def cmd_add_uri(argv):
    uri = argv[0] if argv and not argv[0].startswith("-") else ""
    if not uri:
        uri = read_stdin_or_env("OTP_URI").strip()
    if not uri:
        raise SystemExit("otp: no otpauth:// URI given")
    parsed = parse_uri(uri)
    data = load_index()
    account = add_account(
        data, parsed["label"], parsed["issuer"], parsed["secret"],
        parsed["digits"], parsed["period"], parsed["algorithm"],
    )
    print(f"added {account['label']} ({account['id']}, {account['store']})")
    return 0


def cmd_add_qr(argv):
    """Add an account from a QR screenshot: a file path, or the clipboard."""
    source = ""
    use_clipboard = False
    for flag in argv:
        if flag in ("--clipboard", "-c"):
            use_clipboard = True
        elif not source:
            source = flag

    tmp = ""
    try:
        if use_clipboard or source in ("", "-"):
            tmp = clipboard_image()
            path = tmp
        else:
            path = os.path.expanduser(source)
            if not os.path.exists(path):
                raise SystemExit(f"otp: no such image: {source}")
        parsed = parse_uri(qr_payload(path))
    finally:
        if tmp:
            # The screenshot holds the secret; never leave a copy behind.
            try:
                os.unlink(tmp)
            except OSError:
                pass

    data = load_index()
    account = add_account(
        data, parsed["label"], parsed["issuer"], parsed["secret"],
        parsed["digits"], parsed["period"], parsed["algorithm"],
    )
    print(f"added {account['label']} ({account['id']}, {account['store']})")
    return 0


def cmd_remove(argv):
    ident = None
    name = None
    rest = list(argv)
    while rest:
        flag = rest.pop(0)
        if flag == "--id" and rest:
            ident = rest.pop(0)
        else:
            name = flag
    data = load_index()
    account = find_account(data, name=name, ident=ident)
    if not account:
        raise SystemExit("otp: no such account")
    secret_del(account)
    data["accounts"] = [a for a in data["accounts"] if a["id"] != account["id"]]
    save_index(data)
    print(f"removed {account['label']}")
    return 0


def cmd_copy(argv):
    ident = None
    name = None
    rest = list(argv)
    while rest:
        flag = rest.pop(0)
        if flag == "--id" and rest:
            ident = rest.pop(0)
        else:
            name = flag
    data = load_index()
    account = find_account(data, name=name, ident=ident)
    if not account:
        raise SystemExit("otp: no such account")
    info = code_for(account)
    code = info.get("code") or ""
    if not code:
        raise SystemExit(f"otp: {info.get('error') or 'no code'}")
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy"], input=code, text=True, check=False)
        clear_after = os.environ.get("TOTP_CLIPBOARD_CLEAR", "60")
        if clear_after.isdigit() and int(clear_after) > 0:
            # Detached: clear the clipboard only if it still holds this code, so
            # something copied afterwards is never thrown away. wl-copy's own
            # --paste-once consumed the selection instead of handing it over.
            script = "sleep {d}; [ \"$(wl-paste -n 2>/dev/null)\" = {c} ] && wl-copy --clear".format(
                d=int(clear_after), c=shlex.quote(code)
            )
            subprocess.Popen(
                ["sh", "-c", script],
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
            )
    elif shutil.which("xclip"):
        subprocess.run(["xclip", "-selection", "clipboard"], input=code, text=True, check=False)
    print(code)
    return 0


def cmd_lock(argv):
    action = (argv[0] if argv else "status").strip()
    legacy = lock_state()

    if action == "status":
        print(
            json.dumps(
                {
                    "configured": VAULT.exists() or legacy is not None,
                    "vault": VAULT.exists(),
                    "unlocked": session_password() is not None,
                }
            )
        )
        return 0

    if action in ("unlock", "verify"):
        if not VAULT.exists() and legacy is None:
            return 0
        password = read_password()
        if VAULT.exists():
            vault_read(password)  # wrong password exits here
        else:
            salt = base64.b64decode(legacy["salt"])
            expected = base64.b64decode(legacy["hash"])
            candidate = lock_derive(password, salt, legacy.get("iterations", LOCK_ITERATIONS))
            if not hmac.compare_digest(candidate, expected):
                print("otp: wrong password", file=sys.stderr)
                return 1
            migrate_to_vault(password)
        if action == "unlock":
            set_session(password)
        return 0

    if action == "now":
        clear_session()
        return 0

    if action == "set":
        password = read_password()
        if len(password) < 6:
            raise SystemExit("otp: the master password needs at least 6 characters")
        # Re-wrapping an existing vault requires being unlocked by it first.
        if VAULT.exists():
            current = vault_read(require_session())
        else:
            current = {"version": 1, "secrets": {}}
        data = load_index()
        moved = 0
        for account in data["accounts"]:
            secret = current["secrets"].get(account["id"]) or secret_for(account)
            if secret:
                current["secrets"][account["id"]] = secret
                moved += 1
        vault_write(password, current)
        for account in data["accounts"]:
            secret_del(account)  # the vault is the only copy from here on
            account["store"] = "vault"
        save_index(data)
        try:
            LOCK.unlink()
        except OSError:
            pass
        set_session(password)
        print(f"master password set — {moved} secret(s) encrypted into the vault")
        return 0

    if action == "clear":
        current = vault_read(require_session()) if VAULT.exists() else {"secrets": {}}
        data = load_index()
        try:
            VAULT.unlink()
        except OSError:
            pass
        for account in data["accounts"]:
            secret = current["secrets"].get(account["id"])
            account["store"] = ""
            if secret:
                secret_set(account, secret, data)
        save_index(data)
        clear_session()
        print("master password removed — secrets are back in the login keyring")
        return 0

    if action == "reset":
        if "--yes" not in argv:
            raise SystemExit("otp: reset needs --yes — it destroys every account")
        data = load_index()
        if not VAULT.exists():
            for account in data["accounts"]:
                secret_del(account)
        for path in (VAULT, INDEX, LOCK):
            try:
                path.unlink()
            except OSError:
                pass
        clear_session()
        print("authenticator reset — vault, accounts and session key are gone")
        return 0

    raise SystemExit(f"otp: unknown lock action {action!r}")


def cmd_check(argv):
    data = load_index()
    backend = data.get("backend") or ("keyring" if keyring_available() else "file")
    locked = "locked" if lock_state() is not None else "unlocked"
    print(f"backend={backend} accounts={len(data['accounts'])} lock={locked} index={INDEX}")
    return 0


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    command, rest = argv[0], argv[1:]
    handlers = {
        "list": cmd_list,
        "add": cmd_add,
        "add-uri": cmd_add_uri,
        "add-qr": cmd_add_qr,
        "remove": cmd_remove,
        "copy": cmd_copy,
        "check": cmd_check,
        "lock": cmd_lock,
    }
    if command in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    handler = handlers.get(command)
    if not handler:
        print(f"otp: unknown command {command!r}", file=sys.stderr)
        return 2
    return handler(rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
